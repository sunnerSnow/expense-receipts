{
  "name": "expense-receipts",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  },
  "scripts": {
    "dev": "pnpm --filter @expense-receipts/web dev",
    "worker": "pnpm --filter @expense-receipts/worker dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @expense-receipts/db generate",
    "db:migrate": "pnpm --filter @expense-receipts/db migrate",
    "db:studio": "pnpm --filter @expense-receipts/db studio"
  }
}
