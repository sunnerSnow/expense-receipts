# 複製為 .env 後填入實際值(這個檔案在 monorepo 根目錄,web 與 worker 共用)
DATABASE_URL=postgresql://app:app@localhost:5433/expense_receipts

# session cookie 簽章密鑰(至少 16 字元;正式環境用強隨機值)
SESSION_SECRET=dev-session-secret-change-me

# 公司統編(選填)。只用來比對買方統編、判斷進項稅額可否扣抵。
# 只報海外單據(不會有台灣統編)或不主張進項扣抵 → 留空即可。
# 留空時,有買方統編的統一發票會標為「統編待確認」交人工判斷,不會亂猜。
COMPANY_TAX_ID=

# 單據影像儲存目錄(Phase 1;之後可換物件儲存)
# 相對路徑是相對於 monorepo 根目錄 —— web 與 worker 都要指向同一處
UPLOAD_DIR=./uploads

# 月結匯出產出目錄(CSV + 憑證影像 zip;Phase 3)
EXPORT_DIR=./exports

# Gemini API(Phase 2 AI 辨識,worker 用;見 docs/adr/0004)
# 金鑰在 https://aistudio.google.com/apikey 產生,不要提交進版控
# 格式:`AQ.` 開頭(現行 authorization key)或 `AIzaSy` 開頭(舊 standard key)
# 貼錯字串時 worker 啟動就會擋下來;要驗證金鑰真的可用跑 `pnpm check:ai`
GEMINI_API_KEY=
# 辨識模型:flash 系列支援 vision 且有免費額度,足夠收據辨識(有人工確認關卡兜底)
GEMINI_MODEL=gemini-3.5-flash
